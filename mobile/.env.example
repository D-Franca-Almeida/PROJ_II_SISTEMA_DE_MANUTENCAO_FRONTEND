# Copie para .env e ajuste.
# true = usa o backend falso em memória (shared/src/api/mockServidor.js)
EXPO_PUBLIC_USAR_MOCK=true
# No celular, use o IP da máquina que roda a API (não "localhost"); a API sobe em :5203 (launchSettings.json)
# e precisa escutar na rede: dotnet run --urls http://0.0.0.0:5203
EXPO_PUBLIC_API_URL=http://192.168.0.10:5203/api
